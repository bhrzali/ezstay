# Database
DATABASE_URL=postgresql://rentaplace_user:rentaplace_password@localhost:5432/rentaplace_db

# Users (comma-separated list of usernames)
USERS=admin,user1,user2

# Admin password (will be hashed before storing)
ADMIN_PASSWORD=admin123

# Secret key for JWT (generate a secure random string)
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256

# Application
BACKEND_PORT=8000
